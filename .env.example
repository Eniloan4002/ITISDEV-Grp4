# Copy this file to .env and edit values for your SQL server.
# Do not commit .env (already gitignored).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=AMDB

# Session time zone applied to every pooled connection.
#
# NOW(), CURDATE() and DATE(...) resolve against the MySQL server's zone. When
# the database runs on a VM set to UTC, a 07:00 Manila sale is stored as 23:00
# the previous day, so sale_date, attendance work_date and every daily KPI land
# on the wrong date. Pinning it here keeps behaviour identical on a laptop and
# on a UTC VM. Defaults to +08:00 (Philippine time) if unset.
DB_TIMEZONE=+08:00

# ---------------------------------------------------------------------------
# Running against a shared/VM database with its own account
# ---------------------------------------------------------------------------
# At RUNTIME the app needs only DML on the AMDB schema:
#
#   GRANT SELECT, INSERT, UPDATE, DELETE ON AMDB.* TO 'amdb_app'@'%';
#
# It does NOT need CREATE, DROP or ALTER. server/db.js attempts two legacy
# ADD COLUMN top-ups on boot, but both columns already exist in the creation
# script, and a privilege failure there is logged and ignored rather than
# stopping the app.
#
# The SQL/ scripts are a one-time SETUP task and DO need elevated rights
# (CREATE DATABASE, CREATE TABLE, CREATE VIEW, REFERENCES, DROP for
# "CREATE OR REPLACE VIEW"). Run them as an admin account, not as the app user.
#
# The views are declared SQL SECURITY INVOKER so they run with the querying
# account's privileges. Without that MySQL bakes DEFINER=<creator>@<host> into
# each view and restoring the schema elsewhere fails with
# "The user specified as a definer does not exist".
